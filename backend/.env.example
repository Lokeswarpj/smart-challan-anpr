# Project Configuration
PROJECT_NAME="Vehicle Document Verification System (ANPR)"

# PostgreSQL Database Configuration
# Update with your local PostgreSQL credentials if running locally
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vehicle_db

# Full Database Connection String
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_db
# If PostgreSQL is not reachable, the system automatically falls back to:
# SQLITE_FALLBACK_URL=sqlite:///./vehicle_verification.db

# Security & JWT
SECRET_KEY=anpr-traffic-enforcement-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SMTP Email Dispatch (Optional for live sending)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=traffic-enforcement@dept.gov.in

# SMS Gateway API (Optional: Fast2SMS / Twilio)
SMS_API_KEY=

