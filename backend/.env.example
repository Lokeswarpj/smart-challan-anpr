# Project Configuration
PROJECT_NAME="Vehicle Document Verification System (ANPR)"

# PostgreSQL Database Configuration
# Update with your local PostgreSQL credentials if running locally
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vehicle_db

# Full Database Connection String
# Option 1: Remote / Cloud PostgreSQL (Session or Transaction Pooler)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require
# Option 2: Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_db
# Option 3: Local SQLite fallback is automatic if PostgreSQL is unreachable:
# SQLITE_FALLBACK_URL=sqlite:///./vehicle_verification.db

# Security & JWT
SECRET_KEY=anpr-traffic-enforcement-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SMTP Email Dispatch (Optional for live sending)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=traffic-enforcement@dept.gov.in

# SMS Gateway API (Optional: Fast2SMS for Indian Carrier Delivery)
# Get free API key from https://www.fast2sms.com (Dev API tab)
FAST2SMS_API_KEY=

